  WALK_IN
  WEBSITE
}

enum ReservationEventType {
  CREATED
  UPDATED
  TABLE_ASSIGNED
  TABLE_CHANGED
  CONFIRMED
  CHECKED_IN
  SESSION_LINKED
  CANCELLED
  NO_SHOW
  COMPLETED
  CRON_NO_SHOW
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  READY_FOR_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  SERVED
