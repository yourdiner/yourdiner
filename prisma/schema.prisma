  CREATED
  RENEWED
  UPGRADED
  DOWNGRADE_SCHEDULED
  DOWNGRADE_APPLIED
  CANCELLED
  SUSPENDED
  RESUMED
  EXTENDED
  FREE_DAYS_ADDED
  PLAN_CHANGED
  PAYMENT_FAILED
  PAYMENT_SUCCEEDED
  TRIAL_STARTED
  TRIAL_ENDED
  GRACE_STARTED
  GRACE_REMINDER
  EXPIRY_REMINDER
  SUSPENSION_NOTICE
  WEBHOOK_RECEIVED
  RAZORPAY_PLAN_CREATED
  MANDATE_CREATED
  SYNC_COMPLETED
}

enum RazorpaySyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum MandateStatus {
  NONE
  PENDING
  ACTIVE
  PAUSED
  FAILED
}

enum BillingAuditAction {
  PLAN_CREATED
  PLAN_EDITED
  PLAN_VERSION_CREATED
  RAZORPAY_PLAN_CREATED
  RESTAURANT_PURCHASED
  MANDATE_CREATED
  SUBSCRIPTION_ACTIVATED
  INVOICE_GENERATED
  PAYMENT_CAPTURED
  PAYMENT_FAILED
  RENEWED
  CANCELLED
  WEBHOOK_RECEIVED
  SYNC_COMPLETED
  UPGRADED
  DOWNGRADE_SCHEDULED
  SUSPENDED
  RESUMED
  EXTENDED
  RESTAURANT_DELETED
  RESTAURANT_RESTORED
  RESTAURANT_PERMANENTLY_DELETED
  SUBDOMAIN_DISABLED
  SUBSCRIPTION_CANCELLED
}

enum PlatformRole {
  SUPER_ADMIN
}

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  STAFF
  KITCHEN
  VIEWER
}

enum DietaryType {
  VEG
  NON_VEG
  EGG
  VEGAN
}

enum TableShape {
  SQUARE
  ROUND
  RECTANGLE
  CUSTOM
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  DISABLED
}

enum TableSessionStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  EXPIRED
  CLOSED
}

enum DiningSessionSource {
  STAFF
  CUSTOMER_QR
}

enum DiningSessionStatus {
  ACTIVE
  BILL_REQUESTED
  CLOSED
  CANCELLED
}

enum DiningSessionEventType {
  SESSION_STARTED
  ITEM_ADDED
  ITEM_REMOVED
  ITEM_VOIDED
  SENT_TO_KITCHEN
  KITCHEN_PREPARING
  KITCHEN_READY
  SERVED
  WAITER_ASSIGNED
  WAITER_REASSIGNED
  BILL_REQUESTED
  WAITER_CALLED
  PAYMENT_COMPLETED
  SESSION_CLOSED
  SESSION_CANCELLED
  TABLE_TRANSFERRED
  CUSTOMER_UPDATED
  GUEST_COUNT_UPDATED
  DISCOUNT_APPLIED
  NOTE_ADDED
  SESSION_PENDING_APPROVAL
  SESSION_APPROVED
  SESSION_REJECTED
  CUSTOMER_ORDER_PENDING_APPROVAL
  CUSTOMER_ORDER_APPROVED
  CUSTOMER_ORDER_REJECTED
}

enum SessionPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SessionPaymentMethod {
  CASH
  CARD
  UPI
  OTHER
}

enum OrderItemKitchenStatus {
  PENDING
  SENT
