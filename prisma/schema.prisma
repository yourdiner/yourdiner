generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  DELETED
}

enum CustomDomainStatus {
  NONE
  PENDING
  ACTIVE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum PlanStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RefundStatus {
  NONE
  PENDING
  COMPLETED
  FAILED
}

enum ScheduledChangeType {
  DOWNGRADE
  PLAN_CHANGE
}

