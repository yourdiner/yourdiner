# Database (Neon PostgreSQL)
# Use port 5434 when Docker Postgres is used alongside other projects on 5433
DATABASE_URL="postgresql://restaurant:restaurant@localhost:5434/restaurant_os?schema=public"
DIRECT_URL="postgresql://restaurant:restaurant@localhost:5434/restaurant_os?schema=public"

# Better Auth
BETTER_AUTH_SECRET="generate-a-secure-random-string-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# Cloudinary (uploads go to "Cafe Pos system/{restaurant-slug}/")
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Razorpay (use test keys from Razorpay Dashboard)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdiner.in"

# Redis (optional — other Phase 2 features)
REDIS_URL=""

# Shared rate limiting across serverless instances (Upstash Redis REST)
# Without these, auth rate limits fall back to in-memory (per-instance only).
# Create a free DB at https://upstash.com → copy REST URL + token.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Socket.IO (Phase 2+)
SOCKET_IO_URL=""

# Cron secret (Vercel daily crons + GitHub Actions external crons)
# Also set the same value as GitHub Actions secret CRON_SECRET (see README).
CRON_SECRET="generate-a-secure-random-string-min-32-chars"

# Next.js Server Actions encryption (optional; set a stable value in production)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Extra Server Action allowed origins (comma-separated hosts), e.g. "app.yourdiner.in,admin.yourdiner.in"
SERVER_ACTION_ALLOWED_ORIGINS=""

# Prisma slow-query logging threshold in ms (set 0 or off to disable)
PRISMA_SLOW_QUERY_MS="100"

# Opt-in server timing spans in logs
SERVER_TIMING="0"

# Development impersonation (never enable in production)
ENABLE_DEV_LOGIN="false"
COOKIE_DOMAIN=".localhost"

# Skip Razorpay checkout in local dev (never enable in production)
BILLING_SKIP_PAYMENT="false"
